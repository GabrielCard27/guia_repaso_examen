# Clave de la API de Gemini (Google AI Studio).
# Se obtiene gratis en https://aistudio.google.com -> "Get API key".
# Se configura como variable de entorno en Vercel (Project Settings -> Environment Variables).
# NUNCA se escribe una clave real en este archivo ni en el código fuente.
GEMINI_API_KEY=

# Modelo de Gemini a utilizar para la generación de preguntas.
# gemini-2.5-flash es el valor por defecto: buen balance entre calidad,
# costo y disponibilidad dentro del Free Tier. Se puede cambiar sin tocar
# código (ver README, seccion "Cambiar de modelo Gemini").
GEMINI_MODEL=gemini-2.5-flash
